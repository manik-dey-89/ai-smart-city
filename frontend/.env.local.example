# Frontend environment variables
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — never commit real credentials.

# ─── Google OAuth ──────────────────────────────────────────────────────────
# Same Client ID you set in the backend .env (GOOGLE_CLIENT_ID).
# Get it from: https://console.cloud.google.com/ → APIs & Services → Credentials
# Leave empty to disable Google sign-in (button shows a "not configured" message).
VITE_GOOGLE_CLIENT_ID=
