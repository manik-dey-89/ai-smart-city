# ── Production environment — set BEFORE building / deploying ─────────────────
#
# VITE_API_BASE_URL  (REQUIRED for Render / Railway / any split deployment)
#
# Set this to the BARE backend origin — no trailing slash, no /api suffix.
# The frontend adds /api and individual paths itself.
#
# Example:
#   VITE_API_BASE_URL=https://ai-smart-city-api.onrender.com
#
# On Render Static Site: set this as an Environment Variable in the dashboard.
# Leave empty only when using Docker Compose (nginx proxies /api on same origin).

VITE_API_BASE_URL=

# Google OAuth client ID — same value as backend GOOGLE_CLIENT_ID.
# Leave blank to disable Google sign-in.
VITE_GOOGLE_CLIENT_ID=
