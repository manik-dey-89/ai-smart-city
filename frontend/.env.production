# Production environment — fill in BEFORE deploying.
# Do NOT commit real credentials here.
#
# VITE_API_BASE_URL is documentation only — the app uses a relative /api path
# proxied through nginx at runtime.
#
# VITE_GOOGLE_CLIENT_ID is read at BUILD TIME.
# Set it here or pass it as a Docker build-arg:
#   docker compose build --build-arg VITE_GOOGLE_CLIENT_ID=xxx frontend
# Leave blank to disable Google sign-in.

VITE_API_BASE_URL=
VITE_GOOGLE_CLIENT_ID=
