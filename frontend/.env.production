# ── Production environment — set BEFORE building / deploying ─────────────────
#
# VITE_API_BASE_URL  (REQUIRED for Render / Railway / any split deployment)
# Set this to your deployed backend URL + /api, e.g.:
#   https://ai-smart-city-api.onrender.com/api
#
# Leave empty only when frontend and backend are served from the same origin
# (i.e. Docker Compose where nginx proxies /api → backend container).
#
# On Render: set this as an Environment Variable on the Static Site service,
# NOT here (this file is committed without real values).

VITE_API_BASE_URL=

# Google OAuth client ID (same value as backend GOOGLE_CLIENT_ID).
# Required if Google sign-in is enabled; leave blank to disable.
VITE_GOOGLE_CLIENT_ID=
