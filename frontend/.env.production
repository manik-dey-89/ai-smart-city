# Production environment variables for the SmartCity Dashboard frontend.
#
# IMPORTANT: Replace placeholder values with your actual production credentials
# before deploying.
#
# VITE_API_BASE_URL is a documentation placeholder only — the app uses a
# relative /api path (proxied through nginx) so this variable is not currently
# read at runtime. Set it here as a reminder of your deployed backend URL.
#
# VITE_GOOGLE_CLIENT_ID is read at build time by the Google OAuth hook.
# You MUST set this to your real Google OAuth Client ID from Google Cloud Console.

VITE_API_BASE_URL=https://your-backend-url.onrender.com
VITE_GOOGLE_CLIENT_ID=your-google-client-id
