# ─── Database ────────────────────────────────────────────────────────────────
# SQLite (default, no extra setup needed):
DATABASE_URL=sqlite:///./smartcity.db

# PostgreSQL (for production):
# DATABASE_URL=postgresql://smartcity:strongpassword@localhost:5432/smartcity

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Generate a strong key:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-strong-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (JSON array string)
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# ─── Security ─────────────────────────────────────────────────────────────────
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=30
PASSWORD_MIN_LENGTH=8

# ─── Google OAuth ─────────────────────────────────────────────────────────────
# 1. Go to https://console.cloud.google.com/
# 2. Create a project → APIs & Services → Credentials → Create OAuth 2.0 Client ID
# 3. Application type: Web application
# 4. Authorised JavaScript origins: http://localhost:3000
# 5. Authorised redirect URIs: http://localhost:3000
# 6. Copy Client ID and Client Secret below
# 7. Also set VITE_GOOGLE_CLIENT_ID in frontend/.env.local (same Client ID)
#
# Leave blank to disable Google sign-in (the button will show a "not configured" message).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
